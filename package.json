{
  "name": "neon-drift",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/server.mjs",
    "build": "next build",
    "start": "node --env-file-if-exists=.env scripts/server.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pool:browser": "playwright test",
    "test:pool:integration": "node --env-file=.env --import tsx scripts/pool-integration.ts",
    "db:seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "smoke": "node --env-file=.env --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^9.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.474.0",
    "mongoose": "^9.9.3",
    "next": "^16.3.1",
    "pixi.js": "^8.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
